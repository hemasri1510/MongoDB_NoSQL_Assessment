# MongoDB Connection & Database (Exercises 2, 12, 13, 17)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=threat_intel_chatbot

# Hosted LLM API Configuration - ThreatGuard AI Multi-Model Automatic Failover (FREE Google Gemini API Models ONLY)
LLM_PROVIDER=google_gemini
GEMINI_API_KEY=YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite

# Configurable list of verified free-tier Gemini text models (priority order)
# Starting with gemini-3.1-flash-lite and gemini-4-hydrogen. Never includes paid/Pro models.
GEMINI_FREE_MODELS=gemini-3.1-flash-lite,gemini-4-hydrogen,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash-lite

# Model Health Manager & Failover Resilience Settings
# Cooldown period in seconds for models experiencing temporary failures (503/429/5xx)
GEMINI_COOLDOWN_SECONDS=60
# Max retry attempts per individual model before initiating automatic failover
GEMINI_MAX_ATTEMPTS=3
# Exponential backoff parameters for temporary failures
GEMINI_RETRY_BASE_DELAY=1.0
GEMINI_RETRY_MAX_DELAY=8.0
# Request timeout per HTTP call (seconds)
GEMINI_REQUEST_TIMEOUT=30
# Total end-to-end failover time budget (seconds)
GEMINI_TOTAL_BUDGET_SECONDS=90
# Model discovery cache TTL (seconds) for verifying generateContent support
GEMINI_MODEL_LIST_TTL=600

# Optional Voyage AI Embedding API Key (falls back to deterministic 384-D semantic embeddings offline)
VOYAGE_API_KEY=

# Background Scanner & Security Settings (Exercises 12, 14, 15)
SCAN_INTERVAL_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
APP_ENV=production

# Windows installed-software scanner (read-only)
# auto = scan registry directly if the backend runs on Windows, otherwise call the host agent (windows_agent.py)
SOFTWARE_SCANNER_MODE=auto
SOFTWARE_AGENT_URL=http://host.docker.internal:8765
# Optional shared secret - set the SAME value in the shell that starts windows_agent.py
SOFTWARE_AGENT_TOKEN=
# Seconds to cache a scan (say "refresh" in chat or use ?refresh=true to force a rescan)
SOFTWARE_CACHE_TTL=60
